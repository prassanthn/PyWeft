@property
def today(self):
    return datetime.date.today()

@property
def dates_state(self):
    return f"check_in={self.check_in!r}\nstay={self.stay!r}"

def delete_item(self):
    if self.items:
        self.items -= 1
        toast("Item deleted.", action="Undo", on_action=self.undo)

def undo(self):
    self.items += 1

async def work(self):
    self.busy = True
    await asyncio.sleep(2)
    self.busy = False

def answer(self, text):
    self.verdict = text
    self.confirming = False

@property
def form_state(self):
    return (f"name={self.name!r} email={self.email!r} quantity={self.quantity!r}\n"
            f"size={self.size!r} date={self.date!r} notes={self.notes!r}\n"
            f"phone={self.phone!r} card={self.card!r}")

