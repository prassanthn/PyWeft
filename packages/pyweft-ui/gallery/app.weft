nav_query: str = ""

def _squash(self, text):
    return "".join(text.lower().split())

@property
def nav_items(self):
    """The sections whose name, or a control they show, matches the search;
    with the matching controls when the name alone doesn't say."""
    q = self._squash(self.nav_query)
    out = []
    for name in SECTIONS:
        controls = SECTION_CONTROLS.get(name, [])
        hits = [c for c in controls if q and q in self._squash(c)]
        if not q or q in self._squash(name) or hits:
            shown = [] if q in self._squash(name) else hits
            out.append({"name": name, "slug": name.lower().replace(" ", "-"), "hits": shown})
    return out

def jump_to_first(self):
    items = self.nav_items
    if items and self.nav_query.strip():
        self.scroll_to(items[0]["slug"], align="start")
