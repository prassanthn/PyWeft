</ui.Stepper>

steps = [("account", "Account"), ("delivery", "Delivery"),
         {"value": "gift", "label": "Gift message", "optional": True},
         ("review", "Review")]

def check(self, step):          # False keeps the stepper on this step
    form = {"account": self.account, "delivery": self.delivery}.get(step)
    return form.check() if form is not None else True""",
    "validation": """form = Form(
    email=[rules.required(), rules.email()],
    password=[rules.required(), rules.min_length(8)],
    confirm=rules.same_as("password", "The passwords don't match"),
    agreed=rules.accepted("Agree to the terms to continue"),
)

def submit(self):
    if self.form.check():      # every message shows; the first bad field gets focus
        ...

<ui.TextField ref="email" label="Email" @bind="email"
              :error="form.error('email')" @blur="form.touch('email')" />""",
    "choices": """<ui.RadioGroup label="Plan" :options="[('free', 'Free'), ('pro', 'Pro')]" @bind="plan" />
<ui.Checkbox label="Send me updates" @bind="updates" />
<ui.Switch label="Dark mode" @bind="dark" />""",
    "menus": """<ui.Menu label="File" @select="act(event)" :items="[
    {'heading': 'Document'},
    {'value': 'new', 'label': 'New', 'icon': 'plus', 'hint': 'Ctrl+N'},
    {'label': 'Share', 'items': ['Email', 'Copy link']},
    '-',
    {'value': 'trash', 'label': 'Move to trash', 'danger': True,
     'description': 'Kept for 30 days'},
]" />
<ui.Menu label="Opens above" position="above" :items="..." />
<ui.Menu label="Account" align="end" :items="account">
  <Fill name="trigger"><span class="avatar">AL</span></Fill>
  <Fill name="item">{{ item['label'] }}</Fill>
</ui.Menu>
<ui.ContextMenu :items="['Cut', 'Copy', 'Paste']" @select="act(event)">
  <div>Right-click here</div>
</ui.ContextMenu>""",
    "dates": """<ui.DatePicker label="Check-in" @bind="check_in" :min="today" />
<ui.DateRangePicker label="Stay" @bind="stay" :min="today" min_days="1" />

<ui.Menu label="Actions" @select="act(event)" :items="[
    {'value': 'edit', 'label': 'Edit', 'icon': 'edit'},
    '-',
    {'value': 'delete', 'label': 'Delete', 'icon': 'trash', 'danger': True},
]" />""",
    "autocomplete": """<ui.Autocomplete label="Country" :options="countries" @bind="country" />

<ui.Autocomplete label="Assign to" :options="people" @bind="assignee">
  <Fill name="option">
    <span class="avatar">{{ option['data']['initials'] }}</span>
    {{ option['label'] }} <small>{{ option['data']['email'] }}</small>
  </Fill>
</ui.Autocomplete>

<ui.Autocomplete label="City" :options="cities" match="none" :loading="searching"
                 @search="find_cities(event)" @bind="city" />""",
    "expansion": """<ui.Expansion title="Delivery" description="Address and speed" @bind="delivery_open">
  ... fields ...
  <Fill name="actions"><ui.Button @click="save">Save</ui.Button></Fill>
</ui.Expansion>

<ui.Accordion :options="faq" @bind="question">
  <p>{{ answers[panel] }}</p>
</ui.Accordion>""",
    "toggle": """<ui.ButtonToggle options="Day, Week, Month" @bind="view" />

<ui.ButtonToggle aria_label="Text style" multiple="true" @bind="styles" :options="[
    {'value': 'bold', 'label': 'Bold', 'icon': 'bold', 'icon_only': True},
    {'value': 'italic', 'label': 'Italic', 'icon': 'italic', 'icon_only': True},
]" />

<ui.ButtonToggle label="Plan" options="Monthly, Yearly" full_width="true" @bind="plan" />""",
    "breadcrumbs": """<ui.Breadcrumbs :items="[('/', 'Home'), ('/orders', 'Orders'), 'Order #1041']" />
<ui.Breadcrumbs :items="trail" max="4" separator="slash" />

<!-- In an app with router(): the trail of the current URL, each page
     labelled by `crumb = "Orders"` (or "Order {id}") in its code block -->
<ui.Breadcrumbs auto="true" home_icon="true" />""",
    "cascade": """<ui.CascadeSelect label="City" :options="places" @bind="city"
                  show_path="true" clearable="true" @load="load_cities(event)" />

places = [
    {"value": "au", "label": "Australia", "children": [
        {"value": "nsw", "label": "New South Wales", "children": [
            {"value": "syd", "label": "Sydney"}, ...]},
    ]},
    {"value": "ca", "label": "Canada", "children": None},   # loads when opened
]""",
    "carousel": """<ui.Carousel label="Places" :items="places" @bind="place" loop="true">
  <Fill name="slide">
    <img :src="slide['src']" :alt="slide['alt']" />
  </Fill>
</ui.Carousel>

<ui.Carousel label="Products" :items="products" per_view="3" autoplay="4">
  <Fill name="slide"><ProductCard :product="slide" /></Fill>
</ui.Carousel>""",
    "charts": """<ui.BarChart :data="sales" x="month" y="online, store" title="Sales"
             stacked="true" format="${:,.0f}" @select="open_month(event)" />

<ui.LineChart :data="visits" x="day" y="desktop, mobile" curve="smooth" fill="true" />

<ui.BarChart :data="weather" x="month" y="rain" :series="[
    {'key': 'temp', 'type': 'line', 'axis': 'right', 'color': 'warning'}]" />

<ui.PieChart :data="{'Chrome': 64.7, 'Safari': 18.6, 'Other': 16.7}" />
<ui.PieChart :data="spend" label="category" value="amount" donut="true" center="total" />
<ui.PolarAreaChart :data="tickets" />
<ui.RadarChart :data="skills" x="skill" y="ada, grace" />

sales = [{"month": "Jan", "online": 4200, "store": 3100}, ...]   # or a DataFrame""",
    "tree": """<ui.Tree :nodes="files" @bind="selected" :filter="query"
         @load="load_folder(event)" @activate="open_file(event)" />

<ui.Tree :nodes="permissions" checkable="true" expand_all="true" @bind="granted" />

files = [
    {"value": "src", "label": "src", "icon": "folder", "children": [
        {"value": "app", "label": "app.weft", "icon": "file"},
    ]},
    {"value": "docs", "label": "docs", "icon": "folder", "children": None},  # loads on open
]

async def load_folder(self, value):
    children = await fetch_folder(value)
    ...  # put them in that node's children list""",
    "sliders": """<ui.Slider label="Volume" @bind="volume" format="{}%" />
<ui.Slider label="Price" :min="0" :max="500" :step="10" range="true"
           @bind="price" format="${}" value_label="side" />
<ui.Slider label="Rating" :min="1" :max="5" ticks="true"
           value_label="always" marks="1, 3, 5" @bind="rating" />
<ui.Slider label="Opacity" :max="1" :step="0.05" lazy="true" @bind="opacity" />""",
    "chips": """<ui.Chips options="Small, Medium, Large" @bind="size" />
<ui.Chips :options="interests" multiple="true" @bind="chosen" />
<ui.Chips :options="filters" removable="true" selectable="false"
          @remove="drop_filter(event)" />

<ui.ChipInput label="Tags" @bind="tags" />
<ui.ChipInput label="Invite" :options="people" free="false" @bind="invitees">
  <Fill name="chip">{{ chip['data']['initials'] }} {{ chip['label'] }}</Fill>
</ui.ChipInput>""",
    "calendars": """<ui.Calendar @bind="day" />

<ui.EventCalendar :events="events" @select="open(event)" @day="add(event)" />
<ui.EventCalendar :events="events" months="3" />   <!-- three months, one under another -->

events = [
    {"title": "Standup", "start": datetime.datetime(2026, 11, 3, 9, 30),
     "end": datetime.datetime(2026, 11, 3, 9, 45), "color": "blue"},
    {"title": "Release", "start": datetime.date(2026, 11, 7), "color": "red"},   # all day
    {"title": "Trip", "start": datetime.date(2026, 11, 11), "end": datetime.date(2026, 11, 13)},
]""",
    "feedback": """<ui.Alert kind="success">Saved.</ui.Alert>
<ui.Alert kind="danger" title="Failed" dismissible="true" @close="hide()">...</ui.Alert>
<ui.Badge kind="success">active</ui.Badge>  <ui.Spinner />  <ui.Icon name="star" />""",
    "popover": """<ui.Popover label="Share" icon="send" title="Share this page" @bind="open">
  <ui.TextField label="Link" :value="link" readonly="true" />
  <ui.Button variant="primary" @click="copy">Copy link</ui.Button>
</ui.Popover>

<ui.Popover open_on="hover" variant="link" label="Ada Lovelace">
  <Fill name="trigger">@ada</Fill>
  Ada Lovelace · Owner · 12 projects
</ui.Popover>

<ui.Tooltip text="Bold (Ctrl+B)">
  <ui.Button variant="ghost" icon="bold" aria-label="Bold"></ui.Button>
</ui.Tooltip>""",
    "sheet": """<ui.BottomSheet title="Share" @bind="sharing" :items="[
    {'value': 'link', 'label': 'Copy link', 'icon': 'copy'},
    {'value': 'email', 'label': 'Email', 'description': 'Opens your mail app'},
]" @select="share(event)" />

<ui.BottomSheet title="Filters" @bind="filtering">
  ... any content ...
  <Fill name="actions">
    <ui.Button variant="primary" @click="filtering = False">Show results</ui.Button>
  </Fill>
</ui.BottomSheet>""",
    "dialog": """<ui.Button @click="confirming = True">Delete project</ui.Button>
<ui.Dialog title="Delete project?" @bind="confirming">
  <p>This can't be undone.</p>
  <Fill name="footer">
    <ui.Button @click="confirming = False">Cancel</ui.Button>
    <ui.Button variant="danger" @click="delete()">Delete</ui.Button>
  </Fill>
</ui.Dialog>""",
    "tabs": """<ui.Tabs options="Overview, Activity, Settings" @bind="tab">
  <If cond="tab == 'Overview'"> ... </If>
  <ElseIf cond="tab == 'Activity'"> ... </ElseIf>
  <Else> ... </Else>
</ui.Tabs>""",
    "table": """<ui.Table :rows="orders" row_key="id" sortable="true" @select="open_order"
          :columns="[('id', '#'), 'customer', 'status', {'key': 'total', 'format': ',.2f'}]">
  <Fill name="cell">
    <If cond="column == 'status'"><ui.Badge>{{ text }}</ui.Badge></If>
    <Else>{{ text }}</Else>
  </Fill>
</ui.Table>""",
    "progress": """<ui.Progress label="Uploading" :value="sent" :max="24"
             format="{} of 24 files" show_value="true" />
<ui.Progress label="Waiting for the server" />        <!-- no value: still working -->
<ui.Progress :value="35" :buffer="60" />
<ui.Progress shape="circle" :value="72" kind="warning" size="lg" />""",
    "toasts": """<ui.Toaster />   <!-- once, inside <ui.Theme> -->
<ui.Toaster look="snackbar" />   <!-- or as a snackbar -->

from pyweft_ui import toast
toast("Changes saved.", "success")
toast("Item deleted.", action="Undo", on_action=self.undo)""",
    "layout": """<ui.Grid cols="3" gap="sm"> ... </ui.Grid>
<ui.Row justify="between"> ... </ui.Row>
<ui.Column gap="lg"> ... </ui.Column>

<ui.Divider />
<ui.Divider inset="3.1rem" spacing="none" />   <!-- under a list with avatars -->
<ui.Divider label="or" />
<ui.Divider vertical="true" />                 <!-- between buttons in a Row -->""",
}
</code>

<style>
.avatar {
  flex-shrink: 0; width: 1.9rem; height: 1.9rem; border-radius: 50%;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 0.72rem; font-weight: 700;
  background: color-mix(in srgb, var(--ui-primary) 15%, transparent); color: var(--ui-primary);
}
.cat-label { flex: 1; }
.place {
  display: flex; flex-direction: column; justify-content: flex-end; gap: 2px;
  height: 14rem; padding: 18px 20px; box-sizing: border-box; color: #fff;
}
.place-name { font-size: 1.5rem; font-weight: 700; }
.place-note { opacity: 0.9; }
.product {
  display: flex; flex-direction: column; align-items: flex-start; gap: 6px; height: 100%;
  padding: 14px; box-sizing: border-box;
  border: 1px solid var(--ui-border); border-radius: var(--ui-radius, 8px); background: var(--ui-surface);
}
.product-icon { color: var(--ui-primary); }
.sample { margin: 0; padding: 12px 14px; border-radius: var(--ui-radius, 8px); background: var(--ui-subtle); }
.sample.bold { font-weight: 700; }
.sample.italic { font-style: italic; }
.sample.underline { text-decoration: underline; }
.faq { margin: 0; color: var(--ui-muted, #59636e); }
.avatar.small { width: 1.35rem; height: 1.35rem; font-size: 0.6rem; margin-left: -0.45em; }
.people { display: flex; flex-direction: column; }
.person-row { display: flex; align-items: center; gap: 12px; padding: 8px 0; }
.person { display: flex; flex-direction: column; min-width: 0; flex: 1; }
.person-name { font-weight: 600; }
.person-mail { font-size: 0.8rem; color: var(--ui-muted); overflow: hidden; text-overflow: ellipsis; }
.intro { margin: 0; color: var(--ui-muted); }
.drop-zone {
  display: grid; place-items: center; min-height: 7rem; padding: 16px; text-align: center;
  border: 2px dashed var(--ui-border); border-radius: var(--ui-radius, 8px);
  color: var(--ui-muted); user-select: none;
}
.note { margin: 0; color: var(--ui-muted); font-size: 0.9rem; }
.note.below { margin-top: 12px; }
.panel-text { margin: 0; }
/* Sections jumped to (a link, or Enter in the search) keep a little room above. */
[id] { scroll-margin-top: 16px; }
/* The search stays at the top while the list scrolls under it: a band in
   the page colour over the sidebar's padding, stuck to its scroller. */
.nav-top {
  /* top: -16px: the scroller's 16px padding counts, so 0 would stop short. */
  position: sticky; top: -16px; z-index: 1; flex-basis: 100%;
  margin: -16px -16px 0; padding: 16px 16px 8px;
  background: var(--ui-bg);
}
.nav-search {
  display: block; width: 100%; box-sizing: border-box; padding: 7px 10px;
  font: inherit; font-size: 0.9rem; color: var(--ui-text);
  background: var(--ui-surface); border: 1px solid var(--ui-border); border-radius: var(--ui-radius, 8px);
}
.nav-search:focus { outline: none; border-color: var(--ui-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ui-primary) 25%, transparent); }
.nav-list { display: flex; flex-direction: column; gap: 4px; }
.nav-hits { display: block; font-size: 0.75rem; color: var(--ui-muted); }
.nav-empty { margin: 4px 2px; font-size: 0.85rem; color: var(--ui-muted); }
@media (max-width: 720px) {
  .nav-list { flex-direction: row; flex-wrap: wrap; }
}
.nav-link {
  color: var(--ui-text); text-decoration: none;
  padding: 6px 10px; border-radius: var(--ui-radius);
}
.nav-link:hover { background: var(--ui-subtle); }
.code, .state {
  margin: 12px 0 0; padding: 12px 14px; overflow-x: auto;
  font: 13px/1.5 ui-monospace, SFMono-Regular, Consolas, monospace;
  background: var(--ui-subtle); border: 1px solid var(--ui-border);
  border-radius: var(--ui-radius); white-space: pre;
}
.state { white-space: pre-wrap; }
.tile {
  display: grid; place-items: center; height: 56px; font-weight: 650;
  border-radius: var(--ui-radius);
  background: color-mix(in srgb, var(--ui-primary) 14%, transparent);
  color: var(--ui-primary);
}
.icon-cell {
  display: inline-grid; place-items: center; width: 36px; height: 36px;
  border: 1px solid var(--ui-border); border-radius: var(--ui-radius);
}
</style>
