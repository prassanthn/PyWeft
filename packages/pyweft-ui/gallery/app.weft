async def load_places(self, country):
    await asyncio.sleep(0.6)                        # a pretend server
    states = [{"value": f"{country}-{code}", "label": name,
               "children": [{"value": f"{country}-{code}-{c.lower().replace(' ', '-')}", "label": c} for c in cities]}
              for code, name, cities in PLACE_DATA.get(country, [])]
    self.places = [dict(p, children=states) if p["value"] == country else p for p in self.places]
