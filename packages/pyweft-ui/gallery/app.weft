uploading: bool = False

async def upload(self):
    self.uploading, self.uploaded = True, 0
    while self.uploaded < 24:
        await asyncio.sleep(0.12)          # a pretend upload, a file at a time
        self.uploaded += 1
        self.state_has_changed()
    self.uploading = False
