async def find_cities(self, query):
    # A stand-in for http.get_json(...): a short wait, then the answer.
    # Typing on starts a new search; only the newest one may land.
    self._searches = getattr(self, "_searches", 0) + 1
    mine = self._searches
    self.searching = True
    await asyncio.sleep(0.4)
    if mine != self._searches:
        return
    low = query.strip().lower()
    self.cities = [c for c in self.CITIES if low and low in c.lower()][:8]
    self.searching = False
added_events: list = []

@property
def calendar_events(self):
    # Sample events around today, so the calendar always has something on.
    t = datetime.date.today()
    at = lambda days, hour, minute=0: datetime.datetime.combine(
        t + datetime.timedelta(days=days), datetime.time(hour, minute))
    day = lambda days: t + datetime.timedelta(days=days)
    return [
        {"id": "standup", "title": "Standup", "start": at(0, 9, 30), "end": at(0, 9, 45), "color": "blue"},
        {"id": "one-on-one", "title": "1:1 with Ada", "start": at(0, 9, 30), "end": at(0, 10, 15), "color": "green"},
        {"id": "review", "title": "Design review", "start": at(1, 14), "end": at(1, 15, 30), "color": "purple"},
        {"id": "lunch", "title": "Team lunch", "start": at(2, 12, 30), "end": at(2, 13, 30), "color": "amber"},
        {"id": "release", "title": "Release 0.3", "start": day(4), "color": "red"},
        {"id": "conf", "title": "PyCon trip", "start": day(8), "end": day(10), "color": "teal"},
        {"id": "dentist", "title": "Dentist", "start": at(-3, 8, 45), "end": at(-3, 9, 30), "color": "gray"},
        {"id": "planning", "title": "Sprint planning", "start": at(7, 10), "end": at(7, 11, 30), "color": "blue"},
        {"id": "retro", "title": "Retro", "start": at(6, 16), "end": at(6, 17), "color": "pink"},
    ] + self.added_events

def add_event(self, when):
    start = when if isinstance(when, datetime.datetime) else when
    self.added_events = self.added_events + [
        {"id": f"new-{len(self.added_events)}", "title": "New event", "start": start}]
