<template>
  <ui.Theme :mode="mode" :primary="primary" :radius="radius">
    <ui.AppShell title="pyweft-ui gallery" width="wide">
      <Fill name="actions">
        <ui.Select :options="MODES" @bind="mode" aria-label="Colour mode" />
        <ui.Select :options="ACCENTS" @bind="primary" aria-label="Accent colour" />
        <ui.Select :options="RADII" @bind="radius" aria-label="Corners" />
      </Fill>
      <Fill name="nav">
        <For each="section in SECTIONS" key="section">
          <a class="nav-link" :href="'#' + section.lower().replace(' ', '-')">{{ section }}</a>
        </For>
      </Fill>

      <ui.Column gap="xl">
        <p class="intro">Every control from <b>pyweft-ui</b>, live. Change the theme at the
          top; the code under each section is what produced it.</p>

        <ui.Card title="Buttons" id="buttons">
          <ui.Column>
            <ui.Row>
              <ui.Button variant="primary" @click="clicks += 1">Primary</ui.Button>
              <ui.Button @click="clicks += 1">Secondary</ui.Button>
              <ui.Button variant="ghost" @click="clicks += 1">Ghost</ui.Button>
              <ui.Button variant="danger" icon="trash" @click="clicks += 1">Delete</ui.Button>
            </ui.Row>
            <ui.Row>
              <ui.Button size="sm" icon="plus">Small</ui.Button>
              <ui.Button size="lg" icon="send" variant="primary">Large</ui.Button>
              <ui.Button :loading="busy" variant="primary" @click="work">{{ "Working" if busy else "Load for 2 s" }}</ui.Button>
              <ui.Button disabled="true">Disabled</ui.Button>
            </ui.Row>
            <p class="note">Clicked {{ clicks }} times.</p>
            <pre class="code">{{ CODE['buttons'] }}</pre>
          </ui.Column>
        </ui.Card>

        <ui.Card title="Form fields" id="form" subtitle="Each one is bound with @bind">
          <ui.Grid min_width="16rem" gap="lg">
            <ui.TextField label="Name" placeholder="Ada Lovelace" required="true" @bind="name"
                          :error="'' if len(name) != 1 else 'Too short'" hint="Your full name" />
            <ui.TextField label="Email" type="email" placeholder="you@example.com" @bind="email" />
            <ui.NumberField label="Quantity" min="1" max="99" @bind="quantity" />
            <ui.Select label="Size" placeholder="Choose a size" options="Small, Medium, Large" @bind="size" />
            <ui.TextField label="Date" type="date" @bind="date" />
            <ui.TextField label="Password" type="password" @bind="password" />
            <ui.TextField label="Phone" mask="(999) 999-9999" @bind="phone" hint="Shaped as you type" />
            <ui.TextField label="Card number" mask="9999 9999 9999 9999" @bind="card" />
          </ui.Grid>
          <ui.TextArea label="Notes" rows="3" @bind="notes" placeholder="Anything else?" />
          <pre class="state">{{ form_state }}</pre>
          <pre class="code">{{ CODE['form'] }}</pre>
        </ui.Card>

        <ui.Card title="Validation" id="validation" subtitle="Form and rules: try submitting it empty">
          <Signup />
          <pre class="code">{{ CODE['validation'] }}</pre>
        </ui.Card>

        <ui.Card title="Stepper" id="stepper" subtitle="A checkout in steps; Next checks each one">
          <OrderSteps />
          <pre class="code">{{ CODE['stepper'] }}</pre>
        </ui.Card>

        <ui.Card title="Choices" id="choices">
          <ui.Grid min_width="14rem" gap="lg">
            <ui.RadioGroup label="Plan" :options="PLANS" @bind="plan" />
            <ui.Column gap="sm">
              <ui.Checkbox label="Send me updates" @bind="updates" />
              <ui.Checkbox label="I agree to the terms" @bind="agreed" />
              <ui.Switch label="Dark mode" :value="mode == 'dark'" @update="mode = 'dark' if event else 'light'" />
            </ui.Column>
          </ui.Grid>
          <p class="note">plan = {{ repr(plan) }}, updates = {{ updates }}, agreed = {{ agreed }}</p>
          <pre class="code">{{ CODE['choices'] }}</pre>
        </ui.Card>

        <ui.Card title="Autocomplete" id="autocomplete" subtitle="Suggestions as you type">
          <ui.Column gap="lg">
            <ui.Grid min_width="16rem" gap="lg">
              <ui.Autocomplete label="Country" placeholder="Start typing a country"
                               :options="COUNTRIES" @bind="country" />
              <ui.Autocomplete label="Assign to" placeholder="Name or email"
                               :options="PEOPLE" @bind="assignee">
                <Fill name="option">
                  <span class="avatar">{{ option['data']['initials'] }}</span>
                  <span class="person">
                    <span class="person-name">{{ option['label'] }}</span>
                    <span class="person-mail">{{ option['data']['email'] }}</span>
                  </span>
                  <ui.Badge :kind="'primary' if active else 'neutral'">{{ option['data']['role'] }}</ui.Badge>
                </Fill>
                <Fill name="empty">Nobody matches "{{ query }}"</Fill>
              </ui.Autocomplete>
              <ui.Autocomplete label="City" placeholder="Searched as you type" hint="Results come from a (pretend) server"
                               :options="cities" match="none" :loading="searching"
                               @search="find_cities(event)" @bind="city" />
            </ui.Grid>
            <pre class="state">country={{ repr(country) }}  assignee={{ repr(assignee) }}  city={{ repr(city) }}</pre>
            <pre class="code">{{ CODE['autocomplete'] }}</pre>
          </ui.Column>
        </ui.Card>

        <ui.Card title="Chips" id="chips" subtitle="Choose from a row, or type to add">
          <ui.Column gap="lg">
            <ui.Chips label="Size" options="Small, Medium, Large" @bind="chip_size" required="true" />
            <ui.Chips label="Interests" multiple="true" @bind="interests"
                      :options="[{'value': 'music', 'label': 'Music', 'icon': 'heart'},
                                 {'value': 'travel', 'label': 'Travel', 'icon': 'send'},
                                 {'value': 'books', 'label': 'Books', 'icon': 'star'},
                                 {'value': 'games', 'label': 'Games', 'disabled': True}]" />
            <ui.Row align="center">
              <ui.Chips label="Filters" :options="filters" removable="true" selectable="false"
                        @remove="drop_filter(event)" />
              <If cond="len(filters) &lt; 3">
                <ui.Button size="sm" variant="ghost" @click="filters = ['Open', 'Assigned to me', 'This week']">Reset</ui.Button>
              </If>
            </ui.Row>
            <ui.Grid min_width="16rem" gap="lg">
              <ui.ChipInput label="Tags" placeholder="Type, then Enter or a comma" @bind="tags"
                            hint="Backspace in the empty box removes the last" />
              <ui.ChipInput label="Invite" placeholder="Name or email" :options="PEOPLE" free="false"
                            @bind="invitees">
                <Fill name="chip"><span class="avatar small">{{ chip['data']['initials'] }}</span>{{ chip['label'] }}</Fill>
                <Fill name="option">
                  <span class="avatar">{{ option['data']['initials'] }}</span>
                  <span class="person">
                    <span class="person-name">{{ option['label'] }}</span>
                    <span class="person-mail">{{ option['data']['email'] }}</span>
                  </span>
                </Fill>
              </ui.ChipInput>
            </ui.Grid>
            <pre class="state">size={{ repr(chip_size) }}  interests={{ repr(interests) }}
tags={{ repr(tags) }}  invitees={{ repr(invitees) }}</pre>
            <pre class="code">{{ CODE['chips'] }}</pre>
          </ui.Column>
        </ui.Card>

        <ui.Card title="Button toggle" id="button-toggle" subtitle="A joined row of buttons: one choice, or several">
          <ui.Column gap="lg">
            <ui.Row align="end">
              <ui.ButtonToggle aria_label="Layout" :options="LAYOUTS" @bind="layout" />
              <ui.ButtonToggle label="Range" options="Day, Week, Month" @bind="range_view" size="sm" />
            </ui.Row>
            <ui.Row align="center">
              <ui.ButtonToggle aria_label="Text style" multiple="true" :options="TEXT_STYLES" @bind="text_styles" />
              <ui.ButtonToggle aria_label="Alignment" :options="ALIGNS" @bind="text_align" />
            </ui.Row>
            <p :class="'sample ' + ' '.join(text_styles)" :style="'text-align: ' + text_align">
              The weft is the thread woven through the warp to make fabric.
            </p>
            <ui.ButtonToggle label="Plan" options="Monthly, Yearly, Lifetime" full_width="true" @bind="plan_period"
                             hint="full_width stretches the buttons evenly" />
            <pre class="state">layout={{ repr(layout) }}  range={{ repr(range_view) }}  styles={{ repr(text_styles) }}  align={{ repr(text_align) }}</pre>
            <pre class="code">{{ CODE['toggle'] }}</pre>
          </ui.Column>
        </ui.Card>

        <ui.Card title="Sliders" id="sliders" subtitle="Drag, or use the arrow keys">
          <ui.Grid min_width="16rem" gap="lg">
            <ui.Slider label="Volume" @bind="volume" format="{}%" />
            <ui.Slider label="Price" :min="0" :max="500" :step="10" range="true" @bind="price"
                       format="${}" value_label="side" hint="Thumbs can pass each other" />
            <ui.Slider label="Rating" :min="1" :max="5" ticks="true" value_label="always"
                       marks="1, 3, 5" @bind="rating" />
            <ui.Slider label="Opacity" :min="0" :max="1" :step="0.05" format="{:.2f}"
                       lazy="true" @bind="opacity" hint="Updates when released" />
          </ui.Grid>
          <pre class="state">volume={{ volume }}  price={{ repr(price) }}  rating={{ rating }}  opacity={{ opacity }}</pre>
          <pre class="code">{{ CODE['sliders'] }}</pre>
        </ui.Card>

        <ui.Card title="Expansion panels" id="expansion-panels" subtitle="Open one, or a stack where one is open at a time">
          <ui.Column gap="lg">
            <ui.Expansion title="Delivery" description="Address and speed" icon="send" @bind="delivery_open">
              <ui.Column>
                <ui.TextField label="Street" @bind="street" />
                <ui.RadioGroup label="Speed" options="Standard, Express" @bind="speed" />
              </ui.Column>
              <Fill name="actions">
                <ui.Button variant="ghost" @click="delivery_open = False">Cancel</ui.Button>
                <ui.Button @click="delivery_open = False">Save</ui.Button>
              </Fill>
            </ui.Expansion>
            <ui.Row align="center">
              <ui.Switch label="Several open at once" @bind="many_open" />
            </ui.Row>
            <If cond="many_open">
              <ui.Accordion :options="FAQ" multiple="true" @bind="faq_open">
                <p class="faq">{{ FAQ_ANSWERS[panel] }}</p>
              </ui.Accordion>
            </If>
            <Else>
              <ui.Accordion :options="FAQ" @bind="faq">
                <p class="faq">{{ FAQ_ANSWERS[panel] }}</p>
              </ui.Accordion>
            </Else>
            <pre class="state">delivery_open={{ delivery_open }}  street={{ repr(street) }}  speed={{ repr(speed) }}
faq={{ repr(faq_open if many_open else faq) }}</pre>
            <pre class="code">{{ CODE['expansion'] }}</pre>
          </ui.Column>
        </ui.Card>

        <ui.Card title="Dates and menus" id="dates-and-menus">
          <ui.Column gap="lg">
            <ui.Grid min_width="16rem" gap="lg">
              <ui.DatePicker label="Check-in" @bind="check_in" :min="today" hint="From today on" />
              <ui.DateRangePicker label="Stay" @bind="stay" :min="today" min_days="1"
                                  hint="At least one night" />
            </ui.Grid>
            <ui.Row>
              <ui.Menu label="Actions" :items="MENU" @select="last_action = event" />
              <ui.Menu label="More" icon="more" icon_only="true" variant="ghost"
                       :items="['Copy link', 'Rename', '-', {'value': 'Delete', 'label': 'Delete', 'icon': 'trash', 'danger': True}]"
                       @select="last_action = event" />
              <span class="note">{{ 'You chose: ' + last_action if last_action else 'Nothing chosen yet.' }}</span>
            </ui.Row>
            <pre class="state">{{ dates_state }}</pre>
            <pre class="code">{{ CODE['dates'] }}</pre>
          </ui.Column>
        </ui.Card>

        <ui.Card title="Menus" id="menus" subtitle="Submenus, custom items and triggers, right-click">
          <ui.Column gap="lg">
            <ui.Row align="center">
              <ui.Menu label="File" :items="FILE_MENU" @select="menu_choice = event" />
              <ui.Menu label="Opens above" position="above" :items="['Rename', 'Move', '-', 'Delete']"
                       @select="menu_choice = event" />
              <ui.Menu label="Account" align="end" :items="ACCOUNT_MENU" @select="menu_choice = event">
                <Fill name="trigger"><span class="avatar">AL</span></Fill>
                <Fill name="item">
                  <If cond="item['data'].get('email')">
                    <span class="person">
                      <span class="person-name">{{ item['label'] }}</span>
                      <span class="person-mail">{{ item['data']['email'] }}</span>
                    </span>
                  </If>
                  <Else><ui.Icon :name="item['icon'] or 'user'" size="1.1em" />{{ item['label'] }}</Else>
                </Fill>
              </ui.Menu>
            </ui.Row>
            <ui.ContextMenu :items="CONTEXT_MENU" @select="menu_choice = event">
              <div class="drop-zone" tabindex="0">Right-click here (or focus it and press Shift+F10)</div>
            </ui.ContextMenu>
            <p class="note">{{ 'You chose: ' + str(menu_choice) if menu_choice else 'Nothing chosen yet.' }}</p>
            <pre class="code">{{ CODE['menus'] }}</pre>
          </ui.Column>
        </ui.Card>

        <ui.Card title="Calendars" id="calendars" subtitle="Choosing a date, and showing events">
          <ui.Column gap="lg">
            <ui.Row gap="xl" align="start" wrap="true">
              <ui.Calendar @bind="picked_day" />
              <ui.Column gap="sm">
                <p class="note">A <b>Calendar</b> on the page, always open. Its month and year
                  are buttons too.</p>
                <pre class="state">picked_day={{ repr(picked_day) }}</pre>
              </ui.Column>
            </ui.Row>
            <ui.Switch label="Show two months" @bind="two_months" />
            <ui.EventCalendar label="Team calendar" :events="calendar_events" :months="2 if two_months else 1"
                              @select="picked_event = event['title']" @day="add_event(event)" />
            <p class="note">{{ 'You opened: ' + picked_event if picked_event else 'Click an event, or an empty day to add one.' }}</p>
            <pre class="code">{{ CODE['calendars'] }}</pre>
          </ui.Column>
        </ui.Card>

        <ui.Card title="Feedback" id="feedback">
          <ui.Column>
            <ui.Alert kind="info" title="Heads up">A neutral message.</ui.Alert>
            <ui.Alert kind="success">Saved. Your changes are live.</ui.Alert>
            <ui.Alert kind="warning" title="Careful">This can't be undone.</ui.Alert>
            <If cond="show_danger">
              <ui.Alert kind="danger" title="Failed" dismissible="true" @close="show_danger = False">
                The server didn't answer. Close me with the X.
              </ui.Alert>
            </If>
            <Else><ui.Button size="sm" @click="show_danger = True">Show the error again</ui.Button></Else>
            <ui.Row>
              <ui.Badge>neutral</ui.Badge><ui.Badge kind="primary">primary</ui.Badge>
              <ui.Badge kind="success">active</ui.Badge><ui.Badge kind="warning">pending</ui.Badge>
              <ui.Badge kind="danger">failed</ui.Badge><ui.Spinner /><ui.Spinner size="1em" />
            </ui.Row>
            <ui.Row gap="sm">
              <For each="icon in ICONS" key="icon"><span class="icon-cell" :title="icon"><ui.Icon :name="icon" size="1.3em" /></span></For>
            </ui.Row>
            <pre class="code">{{ CODE['feedback'] }}</pre>
          </ui.Column>
        </ui.Card>

        <ui.Card title="Dialog" id="dialog">
          <ui.Row>
            <ui.Button variant="danger" icon="trash" @click="confirming = True">Delete project</ui.Button>
            <span class="note">{{ verdict }}</span>
          </ui.Row>
          <ui.Dialog title="Delete project?" @bind="confirming" @close="verdict = verdict or 'Dismissed.'">
            <p>This removes the project and its 12 files. It can't be undone.</p>
            <Fill name="footer">
              <ui.Button @click="answer('Kept it.')">Cancel</ui.Button>
              <ui.Button variant="danger" @click="answer('Deleted.')">Delete</ui.Button>
            </Fill>
          </ui.Dialog>
          <pre class="code">{{ CODE['dialog'] }}</pre>
        </ui.Card>

        <ui.Card title="Bottom sheet" id="bottom-sheet" subtitle="Slides up from the bottom: swipe it down, press Esc or tap outside">
          <ui.Row align="center">
            <ui.Button icon="send" @click="sharing = True">Share</ui.Button>
            <ui.Button variant="secondary" icon="settings" @click="filtering = True">Filters</ui.Button>
            <span class="note">{{ sheet_note }}</span>
          </ui.Row>
          <ui.BottomSheet title="Share" @bind="sharing" :items="SHARE"
                          @select="shared = event" @close="sheet_closed = event" />
          <ui.BottomSheet title="Filters" @bind="filtering" @close="sheet_closed = event">
            <ui.Column gap="lg">
              <ui.Chips label="Status" options="Open, In progress, Done" multiple="true" @bind="filter_status" />
              <ui.Slider label="Price" :max="500" :step="10" range="true" format="${}" value_label="side" @bind="filter_price" />
              <ui.Switch label="Only items in stock" @bind="filter_stock" />
            </ui.Column>
            <Fill name="actions">
              <ui.Button variant="ghost" @click="reset_filters">Reset</ui.Button>
              <ui.Button variant="primary" @click="filtering = False">Show results</ui.Button>
            </Fill>
          </ui.BottomSheet>
          <pre class="code">{{ CODE['sheet'] }}</pre>
        </ui.Card>

        <ui.Card title="Tabs" id="tabs">
          <ui.Column gap="lg">
            <ui.Tabs label="Project" options="Overview, Activity, Settings" @bind="tab">
              <If cond="tab == 'Overview'"><p class="panel-text">Three people are working on this project.</p></If>
              <ElseIf cond="tab == 'Activity'"><p class="panel-text">Ada pushed 4 commits an hour ago.</p></ElseIf>
              <Else><ui.Switch label="Email me about changes" @bind="updates" /></Else>
            </ui.Tabs>
            <ui.Tabs variant="pills" :options="[('day', 'Day'), ('week', 'Week'), ('month', 'Month')]">
              <p class="panel-text">Showing one {{ tab }}.</p>
            </ui.Tabs>
          </ui.Column>
          <pre class="code">{{ CODE['tabs'] }}</pre>
        </ui.Card>

        <ui.Card title="Table" id="table" subtitle="Click a heading to sort, a row to pick it">
          <ui.Table :rows="ORDERS" row_key="id" sortable="true" sort="-total" @select="picked = event"
                    :columns="[('id', '#'), 'customer', 'status', {'key': 'total', 'format': ',.2f'}]">
            <Fill name="cell">
              <If cond="column == 'status'"><ui.Badge :kind="STATUS_KINDS[value]">{{ text }}</ui.Badge></If>
              <Else>{{ text }}</Else>
            </Fill>
          </ui.Table>
          <p class="note below">Picked: {{ picked['customer'] + ', order ' + str(picked['id']) if picked else 'nothing yet' }}</p>
          <pre class="code">{{ CODE['table'] }}</pre>
        </ui.Card>

        <ui.Card title="Toasts" id="toasts" subtitle="Messages that go away by themselves">
          <ui.Row>
            <ui.Button variant="primary" icon="check" @click="toast('Changes saved.', 'success')">Save</ui.Button>
            <ui.Button icon="info" @click="toast('A new version is ready.', title='Update')">Info</ui.Button>
            <ui.Button icon="alert" @click="toast('Disk almost full.', 'warning', duration=None)">Stays until closed</ui.Button>
            <ui.Button variant="danger" icon="trash" @click="delete_item">Delete with undo</ui.Button>
          </ui.Row>
          <p class="note below">Items: {{ items }}</p>
          <pre class="code">{{ CODE['toasts'] }}</pre>
        </ui.Card>

        <ui.Card title="Layout" id="layout" subtitle="Row, Column, Grid and Card: no CSS needed">
          <ui.Grid cols="3" gap="sm">
            <For each="n in range(1, 7)" key="n"><div class="tile">{{ n }}</div></For>
          </ui.Grid>
          <pre class="code">{{ CODE['layout'] }}</pre>
        </ui.Card>
      </ui.Column>
    </ui.AppShell>
    <ui.Toaster />
  </ui.Theme>
</template>

<code>
import asyncio
import datetime
from pyweft_ui import toast, ui

SECTIONS = ["Buttons", "Form", "Validation", "Stepper", "Choices", "Autocomplete", "Chips", "Button toggle", "Sliders", "Expansion panels", "Dates and menus", "Menus", "Calendars", "Feedback", "Dialog", "Bottom sheet", "Tabs", "Table", "Toasts", "Layout"]
ORDERS = [
    {"id": 1041, "customer": "Ada Lovelace", "status": "paid", "total": 1250.0},
    {"id": 1042, "customer": "Grace Hopper", "status": "pending", "total": 89.9},
    {"id": 1043, "customer": "Alan Turing", "status": "refunded", "total": 410.0},
    {"id": 1044, "customer": "Katherine Johnson", "status": "paid", "total": 72.5},
]
STATUS_KINDS = {"paid": "success", "pending": "warning", "refunded": "neutral"}
MODES = [("light", "Light"), ("dark", "Dark"), ("auto", "System")]
ACCENTS = [("", "Indigo"), ("#0f766e", "Teal"), ("#c2410c", "Orange"), ("#be185d", "Pink")]
RADII = [("", "Rounded"), ("2px", "Square"), ("14px", "Round")]
PLANS = [("free", "Free"), ("pro", "Pro — $8/mo"), ("team", "Team — $20/mo")]
ICONS = ["check", "x", "plus", "minus", "search", "info", "alert", "menu", "more",
         "chevron-up", "chevron-down", "chevron-left", "chevron-right", "trash", "edit",
         "send", "copy", "download", "upload", "external", "user", "home", "star", "heart",
         "calendar", "settings", "sun", "moon"]

mode: str = "light"
primary: str = ""
radius: str = ""
clicks: int = 0
busy: bool = False
name: str = ""
email: str = ""
quantity: int = 1
size = None
date: str = ""
password: str = ""
notes: str = ""
phone: str = ""
card: str = ""
plan: str = "pro"
updates: bool = True
agreed: bool = False
show_danger: bool = True
confirming: bool = False
verdict: str = ""
tab: str = "Overview"
picked = None
items: int = 3
check_in = None
stay = None
last_action: str = ""
menu_choice = None
sharing: bool = False
filtering: bool = False
shared = None
sheet_closed = None
filter_status: list = ["Open"]
filter_price: tuple = (0, 500)
filter_stock: bool = False
SHARE = [
    {"value": "link", "label": "Copy link", "icon": "copy"},
    {"value": "email", "label": "Email", "icon": "send", "description": "Opens your mail app"},
    {"value": "download", "label": "Download", "icon": "download"},
    {"value": "print", "label": "Print", "icon": "external", "disabled": True},
]

@property
def sheet_note(self):
    parts = []
    if self.shared:
        parts.append(f"Shared by {self.shared}")
    if self.sheet_closed:
        parts.append(f"last closed by {self.sheet_closed}")
    filters = ", ".join(self.filter_status) or "any status"
    parts.append(f"filters: {filters}, ${self.filter_price[0]}-{self.filter_price[1]}"
                 + (", in stock" if self.filter_stock else ""))
    return "; ".join(parts)

def reset_filters(self):
    self.filter_status, self.filter_price, self.filter_stock = [], (0, 500), False
FILE_MENU = [
    {"heading": "Document"},
    {"value": "new", "label": "New", "icon": "plus", "hint": "Ctrl+N"},
    {"value": "copy", "label": "Make a copy", "icon": "copy", "hint": "Ctrl+D"},
    {"label": "Share", "icon": "send", "items": [
        {"value": "email", "label": "Email"},
        {"value": "link", "label": "Copy link", "icon": "copy"},
        {"label": "Export as", "icon": "download", "items": ["PDF", "Word", ("md", "Markdown")]},
    ]},
    "-",
    {"value": "trash", "label": "Move to trash", "icon": "trash", "danger": True,
     "description": "Kept for 30 days"},
]
ACCOUNT_MENU = [
    {"value": "me", "label": "Ada Lovelace", "email": "ada@engine.org"},
    "-",
    {"value": "settings", "label": "Settings", "icon": "settings"},
    {"label": "Theme", "icon": "sun", "items": [
        {"value": "light", "label": "Light", "icon": "sun"},
        {"value": "dark", "label": "Dark", "icon": "moon"},
    ]},
    {"value": "out", "label": "Sign out", "icon": "external"},
]
CONTEXT_MENU = [
    {"value": "cut", "label": "Cut", "hint": "Ctrl+X"},
    {"value": "copy", "label": "Copy", "icon": "copy", "hint": "Ctrl+C"},
