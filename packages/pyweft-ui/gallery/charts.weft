<template>
  <ui.Column gap="lg">
    <ui.Row align="center">
      <ui.ButtonToggle label="Bars" :options="BAR_MODES" @bind="bar_mode" />
      <ui.ButtonToggle label="Lines" :options="CURVES" @bind="curve" />
      <ui.Button icon="star" @click="shuffle">New numbers</ui.Button>
    </ui.Row>
    <ui.Grid min_width="12rem" gap="md">
      <For each="stat in stats" key="stat['name']">
        <div class="box stat">
          <span class="stat-name">{{ stat['name'] }}</span>
          <span class="stat-value">{{ stat['value'] }}</span>
          <span :class="'delta up' if stat['up'] else 'delta down'">{{ stat['delta'] }}</span>
          <ui.Sparkline :data="stat['trend']" :kind="stat['kind']" :name="stat['name']" height="36"
                        :color="'' if stat['up'] else 'danger'" points="last" />
        </div>
      </For>
    </ui.Grid>
    <ui.Grid min_width="14rem" gap="md">
      <div class="box gauge-box"><ui.Gauge :value="cpu" label="CPU" format="{:.0f}%"
                                            bands="60:success, 85:warning, 100:danger" /></div>
      <div class="box gauge-box"><ui.Gauge :value="memory" max="32" label="Memory" format="{:.1f} GB"
                                            half="true" /></div>
      <div class="box gauge-box"><ui.Gauge :value="score" max="10" label="Satisfaction" format="{:.1f}"
                                            needle="true" bands="4:danger, 7:warning, 10:success" /></div>
    </ui.Grid>
    <ui.Grid min_width="20rem" gap="lg">
      <div class="box">
        <ui.BarChart :data="sales" x="month" y="online, store" title="Sales" subtitle="Click a bar"
                     :stacked="bar_mode" format="${:,.0f}" @select="picked = event" />
        <p class="note">{{ picked_text }}</p>
      </div>
      <div class="box">
        <ui.BarChart :data="LANGUAGES" horizontal="true" labels="true" title="Languages used" format="{}%"
                     legend="none" colors="#0d9488" />
      </div>
      <div class="box">
        <ui.LineChart :data="visits" x="day" y="desktop, mobile, tablet" :curve="curve" title="Visits"
                      y_label="Visitors" />
      </div>
      <div class="box">
        <ui.LineChart :data="visits" x="day" y="desktop, mobile, tablet" :curve="curve" fill="true"
                      stacked="true" title="Stacked area" legend="bottom" />
      </div>
      <div class="box">
        <ui.BarChart :data="WEATHER" x="month" y="rain" title="Weather" subtitle="Two scales: a combo chart"
                     :series="WEATHER_SERIES" y_label="Rain (mm)" y2_label="Temperature (°C)" />
      </div>
      <div class="box">
        <ui.LineChart :data="STYLES" x="week" title="Line styles" :series="STYLE_SERIES" />
      </div>
      <div class="box">
        <ui.PieChart :data="BROWSERS" title="Browsers" format="{}%" legend="right" />
      </div>
      <div class="box">
        <ui.PieChart :data="SPEND" label="category" value="amount" donut="true" center="total"
                     center_label="spent" title="Spending" format="${:,.0f}" labels="none" legend="bottom" />
      </div>
      <div class="box">
        <ui.PieChart :data="SEATS" donut="true" half="true" height="190" title="Seats" center="total"
                     center_label="seats" labels="value" legend="bottom" />
      </div>
      <div class="box">
        <ui.PolarAreaChart :data="TICKETS" title="Tickets by day" legend="bottom" />
      </div>
      <div class="box">
        <ui.ScatterChart :data="PEOPLE" x="height" y="weight" group="group" label="name" trend="true"
                         title="Height and weight" x_label="Height (cm)" y_label="Weight (kg)" />
      </div>
      <div class="box">
        <ui.ScatterChart :data="COUNTRIES" x="income" y="life" size="people" label="name" title="Countries"
                         subtitle="Bubble size: population (millions)" x_label="Income per person ($k)"
                         y_label="Life expectancy" size_label="Population (m)" legend="none" />
      </div>
      <div class="box">
        <ui.FunnelChart :data="FUNNEL" title="Sign-up funnel" />
      </div>
      <div class="box">
        <ui.FunnelChart :data="FUNNEL" title="As a funnel" shape="funnel" colors="#0d9488, #0284c7, #9333ea, #db2777, #dc2626" />
      </div>
      <div class="box">
        <ui.WaterfallChart :data="BRIDGE" label="item" value="amount" totals="Revenue, Profit" title="Revenue to profit"
                           format="${:,.0f}" tick_format="${:,.0f}" />
      </div>
      <div class="box">
        <ui.LineChart :data="FORECAST" x="month" title="Forecast" subtitle="With a 90% interval and a trend line"
                      :series="FORECAST_SERIES" connect_gaps="true" />
      </div>
      <div class="box">
        <ui.BarChart :data="TRIALS" x="dose" y="effect" title="Trial results" subtitle="Mean ± standard error"
                     :series="[{'key': 'effect', 'label': 'Effect', 'error': 'se'}]" legend="none" />
      </div>
      <div class="box">
        <ui.Histogram :data="HEIGHTS" y="height" group="group" curve="true" show_mean="true" title="Heights"
                      x_label="Height (cm)" />
      </div>
      <div class="box">
        <ui.BoxPlot :data="TIMES" title="Response times" subtitle="Box plot, outliers as dots" y_label="ms" />
      </div>
      <div class="box">
        <ui.BoxPlot :data="TIMES" violin="true" title="The same, as violins" y_label="ms" />
      </div>
      <div class="box">
        <ui.Heatmap :data="ACTIVITY" x="hour" y="day" value="visits" title="Visits by hour" />
      </div>
      <div class="box">
        <ui.CorrelationMatrix :data="CARS" triangle="lower" title="What moves together"
                              subtitle="Correlation of car measures" />
      </div>
      <div class="box">
        <ui.CandlestickChart :data="PRICES" averages="5, 20" title="ACME shares" format="${:,.2f}"
                             tick_format="${:,.0f}" />
      </div>
      <div class="box">
        <ui.Treemap :data="REGION_SALES" path="region, country" value="sales" title="Sales by region"
                    format="${:,.0f}k" />
      </div>
      <div class="box">
        <ui.SankeyChart :data="BUDGET" title="Where the money goes" format="${:,.0f}" />
      </div>
    </ui.Grid>
    <div class="box">
      <ui.CalendarHeatmap :data="CONTRIBUTIONS" title="Contributions" subtitle="A year of days" />
    </div>
    <ui.Grid min_width="20rem" gap="lg">
      <div class="box">
        <ui.RadarChart :data="SKILLS" x="skill" y="ada, grace" :series="SKILL_NAMES" title="Skills" />
      </div>
    </ui.Grid>
  </ui.Column>
</template>

<code>
# Every chart, with data a real app would have; the toggles restyle the
# first ones live and "New numbers" changes the data.
import datetime
import math
import random

from pyweft_ui import ui

BAR_MODES = [("", "Grouped"), ("true", "Stacked"), ("percent", "100%")]
CURVES = [("linear", "Straight"), ("smooth", "Smooth"), ("step", "Steps")]
MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]
DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
LANGUAGES = {"JavaScript": 62, "Python": 51, "SQL": 51, "TypeScript": 38, "Java": 30, "C#": 27, "Go": 14}
WEATHER = [{"month": m, "rain": r, "temp": t} for m, r, t in zip(
    MONTHS, [78, 52, 61, 45, 50, 46], [4.2, 5.1, 8.3, 11.6, 15.2, 18.4])]
WEATHER_SERIES = [{"key": "rain", "label": "Rain"},
                  {"key": "temp", "label": "Temperature", "type": "line", "axis": "right", "curve": "smooth",
                   "color": "warning"}]
STYLES = [{"week": f"W{i + 1}", "plan": p, "actual": a, "forecast": f}
          for i, (p, a, f) in enumerate(zip([40, 45, 50, 55, 60, 65, 70], [38, 47, 49, 58, None, None, None],
                                            [None, None, None, 58, 63, 66, 72]))]
STYLE_SERIES = [{"key": "plan", "label": "Plan", "dash": "2 4", "points": False, "color": "muted"},
                {"key": "actual", "label": "Actual"},
                {"key": "forecast", "label": "Forecast", "dash": True, "curve": "smooth"}]
BROWSERS = {"Chrome": 64.7, "Safari": 18.6, "Edge": 5.2, "Firefox": 2.8, "Other": 8.7}
SPEND = [{"category": "Rent", "amount": 1450}, {"category": "Food", "amount": 520},
         {"category": "Travel", "amount": 310}, {"category": "Fun", "amount": 190}]
SEATS = {"Green": 42, "Blue": 35, "Red": 23, "Other": 10}
TICKETS = {"Mon": 18, "Tue": 25, "Wed": 12, "Thu": 9, "Fri": 21}
SKILLS = [{"skill": s, "ada": a, "grace": g} for s, a, g in zip(
    ["Python", "SQL", "Design", "Testing", "Ops", "Writing"], [9, 7, 5, 8, 4, 7], [6, 8, 7, 6, 9, 5])]
PEOPLE = [{"name": f"Person {i + 1}", "height": h, "weight": w, "group": g} for i, (h, w, g) in enumerate([
    (152, 49, "Under 30"), (158, 55, "Under 30"), (163, 54, "Under 30"), (167, 63, "Under 30"),
    (171, 64, "Under 30"), (176, 70, "Under 30"), (181, 73, "Under 30"), (186, 79, "Under 30"),
    (155, 58, "30 and over"), (160, 63, "30 and over"), (165, 66, "30 and over"), (170, 74, "30 and over"),
    (174, 77, "30 and over"), (178, 79, "30 and over"), (183, 88, "30 and over"), (189, 92, "30 and over")])]
COUNTRIES = [{"name": n, "income": i, "life": l, "people": p} for n, i, l, p in [
    ("Aland", 52, 82.1, 38), ("Borovia", 31, 78.4, 120), ("Cerulea", 8, 67.2, 210), ("Dunmore", 14, 72.5, 64),
    ("Estria", 44, 81.3, 9), ("Faro", 3, 61.8, 95), ("Galen", 23, 76.9, 330), ("Hollin", 61, 83.0, 6)]]
FUNNEL = {"Visited the site": 12400, "Started sign-up": 4100, "Confirmed email": 2650, "Started a trial": 980,
          "Paid": 310}
BRIDGE = [{"item": "Revenue", "amount": 48000}, {"item": "Cost of goods", "amount": -19500},
          {"item": "Salaries", "amount": -14200}, {"item": "Marketing", "amount": -4100},
          {"item": "Other income", "amount": 2300}, {"item": "Tax", "amount": -3100}, {"item": "Profit"}]
_rnd = random.Random(7)
FORECAST = [{"month": m, "actual": a, "forecast": f, "low": lo, "high": hi} for m, a, f, lo, hi in [
    ("Jan", 120, None, None, None), ("Feb", 132, None, None, None), ("Mar", 128, None, None, None),
    ("Apr", 141, None, None, None), ("May", 150, 150, 150, 150), ("Jun", None, 156, 148, 164),
    ("Jul", None, 163, 150, 176), ("Aug", None, 169, 151, 187), ("Sep", None, 176, 153, 199)]]
FORECAST_SERIES = [{"key": "actual", "label": "Actual", "trend": True},
                   {"key": "forecast", "label": "Forecast", "dash": True, "lower": "low", "upper": "high"}]
TRIALS = [{"dose": d, "effect": e, "se": se} for d, e, se in
          [("Placebo", 1.2, 0.6), ("5 mg", 2.9, 0.7), ("10 mg", 4.4, 0.8), ("20 mg", 5.1, 1.1)]]
HEIGHTS = [{"group": g, "height": round(_rnd.gauss(m, 7), 1)} for g, m in (("Women", 164), ("Men", 177))
           for _ in range(160)]
TIMES = {name: [round(_rnd.lognormvariate(mu, 0.35)) for _ in range(60)]
         for name, mu in (("Search", 4.6), ("Checkout", 5.2), ("Login", 4.2), ("Upload", 5.6))}
ACTIVITY = [{"day": d, "hour": f"{h:02d}", "visits": round(max(0, 40 * math.sin((h - 6) / 16 * math.pi)
            + (25 if d in ("Sat", "Sun") and 10 <= h <= 16 else 0) + _rnd.uniform(-6, 6)))}
            for d in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] for h in range(6, 24)]
CARS = []
for _ in range(40):
    _weight = _rnd.uniform(900, 2200)
    _power = _weight * 0.08 + _rnd.uniform(-30, 40)
    CARS.append({"price": round(_power * 260 + _rnd.uniform(-4000, 4000)), "power": round(_power),
                 "weight": round(_weight), "mpg": round(70 - _weight / 50 + _rnd.uniform(-5, 5), 1),
                 "doors": _rnd.choice([3, 5])})
PRICES = []
_price = 84.0
for _i in range(60):
    _close = _price * (1 + _rnd.gauss(0.002, 0.018))
    PRICES.append({"date": f"{['Mar', 'Apr', 'May'][_i // 20]} {_i % 20 + 1}", "open": round(_price, 2),
                   "high": round(max(_price, _close) * (1 + abs(_rnd.gauss(0, 0.008))), 2),
                   "low": round(min(_price, _close) * (1 - abs(_rnd.gauss(0, 0.008))), 2),
                   "close": round(_close, 2), "volume": _rnd.randint(8, 30) * 1000})
    _price = _close
REGION_SALES = [{"region": r, "country": c, "sales": v} for r, c, v in [
    ("Europe", "Germany", 182), ("Europe", "France", 140), ("Europe", "Spain", 76), ("Europe", "Italy", 98),
    ("Europe", "Sweden", 41), ("Americas", "USA", 260), ("Americas", "Canada", 64), ("Americas", "Brazil", 88),
    ("Asia", "Japan", 150), ("Asia", "India", 120), ("Asia", "Korea", 58), ("Oceania", "Australia", 49)]]
BUDGET = [("Salary", "Budget", 5200), ("Freelance", "Budget", 1300), ("Budget", "Housing", 1900),
          ("Budget", "Food", 850), ("Budget", "Transport", 420), ("Budget", "Fun", 630), ("Budget", "Savings", 2700),
          ("Savings", "Index funds", 1800), ("Savings", "Emergency fund", 900)]
_today = datetime.date(2026, 11, 4)
CONTRIBUTIONS = {}
for _k in range(365):
    _day = _today - datetime.timedelta(days=_k)
    CONTRIBUTIONS[_day.isoformat()] = _rnd.choice([0, 0, 1, 2, 3, 5, 8] if _day.weekday() < 5 else [0, 0, 0, 1])
SKILL_NAMES = [{"key": "ada", "label": "Ada"}, {"key": "grace", "label": "Grace"}]

sales: list = [{"month": m, "online": o, "store": s} for m, o, s in zip(
    MONTHS, [4200, 5100, 4800, 6100, 7000, 6600], [3100, 2900, 3500, 3300, 3600, 4100])]
visits: list = [{"day": d, "desktop": a, "mobile": b, "tablet": c} for d, a, b, c in zip(
    DAYS, [820, 932, 901, 934, 1290, 610, 520], [620, 732, 801, 1034, 990, 1120, 1210], [120, 132, 101, 134, 190, 230, 210])]
cpu: float = 68
memory: float = 21.5
score: float = 7.8
stats: list = [
    {"name": "Revenue", "value": "$48.2k", "delta": "+12% this month", "up": True, "kind": "area",
     "trend": [31, 33, 32, 36, 38, 37, 41, 44, 43, 48]},
    {"name": "Orders", "value": "1,284", "delta": "+4% this month", "up": True, "kind": "bar",
     "trend": [102, 118, 96, 131, 125, 140, 133, 129, 147, 152]},
    {"name": "Refunds", "value": "37", "delta": "+9 this month", "up": False, "kind": "line",
     "trend": [21, 25, 24, 22, 28, 30, 27, 33, 35, 37]},
]
bar_mode: str = ""
curve: str = "linear"
picked = None

@property
def picked_text(self):
    p = self.picked
    if not p:
        return "Nothing picked yet."
    if p["series"] is None:  # a whole month, from the keyboard (Enter)
        return f"{p['label']}: " + ", ".join(f"{k} ${v:,.0f}" for k, v in p["values"].items() if v is not None)
    return f"{p['label']}: {p['series']} ${p['value']:,.0f}"

def shuffle(self):
    self.sales = [{"month": m, "online": random.randint(3000, 8000), "store": random.randint(2000, 5000)}
                  for m in MONTHS]
    self.cpu = random.uniform(20, 98)
    self.memory = random.uniform(4, 31)
    self.score = random.uniform(2, 10)
    self.visits = [{"day": d, "desktop": random.randint(400, 1400), "mobile": random.randint(400, 1400),
                    "tablet": random.randint(80, 300)} for d in DAYS]
</code>

<style>
.box {
  padding: 0.875rem;
  border: 1px solid var(--ui-border, #d1d9e0);
  border-radius: var(--ui-radius, 8px);
  min-width: 0;
}
.stat { display: flex; flex-direction: column; gap: 0.125rem; }
.stat-name { color: var(--ui-muted, #59636e); font-size: 0.8125rem; }
.stat-value { font-size: 1.5rem; font-weight: 600; line-height: 1.2; }
.delta { font-size: 0.8125rem; margin-bottom: 0.25rem; }
.delta.up { color: var(--ui-success, #1a7f37); }
.delta.down { color: var(--ui-danger, #d1242f); }
.gauge-box { display: flex; justify-content: center; align-items: center; }
.note { margin: 0.5rem 0 0; color: var(--ui-muted, #59636e); font-size: 0.875rem; }
</style>
