<template>
  <label class="switch">
    <input type="checkbox" role="switch" :checked="value" :name="name or None"
           :disabled="disabled" :aria-invalid="'true' if error else None"
           @change="emit('update', event.checked)" />
    <span class="track" aria-hidden="true"><span class="thumb"></span></span>
    <span class="text"><Slot>{{ label }}</Slot></span>
    <If cond="error"><span class="error">{{ error }}</span></If>
  </label>
</template>

<code>
# <ui.Switch label="Dark mode" @bind="dark" />: an on/off toggle.
label: str = ""
value: bool = False
name: str = ""
error: str = ""           # shown under it, in red
disabled: bool = False
</code>

<style>
.switch { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; cursor: pointer; position: relative; }
.error { flex-basis: 100%; font-size: 0.82rem; color: var(--ui-danger, #d1242f); }
input[aria-invalid="true"] + .track { box-shadow: 0 0 0 2px var(--ui-danger, #d1242f); }
input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
.track {
  width: 2.3em; height: 1.3em; border-radius: 999px; flex-shrink: 0;
  background: var(--ui-border, #d1d9e0);
  display: inline-flex; align-items: center; padding: 2px; box-sizing: border-box;
  transition: background-color 0.15s;
}
.thumb {
  width: calc(1.3em - 4px); height: calc(1.3em - 4px); border-radius: 50%;
  background: #fff; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  transition: transform 0.15s;
}
input:checked + .track { background: var(--ui-primary, #4f46e5); }
input:checked + .track .thumb { transform: translateX(1em); }
input:focus-visible + .track {
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--ui-primary, #4f46e5) 35%, transparent);
}
input:disabled + .track { opacity: 0.55; }
input:disabled ~ .text { opacity: 0.6; }
</style>
