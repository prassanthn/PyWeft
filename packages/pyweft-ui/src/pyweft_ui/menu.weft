<template>
  <div :class="'menu align-' + align + ' pos-' + position">
    <If cond="has_slot('trigger')">
      <button type="button" ref="trigger" :id="_id + '-button'" class="trigger bare"
              aria-haspopup="menu" :aria-expanded="'true' if _open else 'false'"
              :aria-controls="_id + '-list' if _open else None" :aria-label="label"
              :disabled="disabled"
              @click="toggle" @keydown.down.prevent="open_at('first')" @keydown.up.prevent="open_at('last')"><Slot name="trigger" /></button>
    </If>
    <Else>
      <button type="button" ref="trigger" :id="_id + '-button'"
              :class="'trigger btn-' + variant + (' icon-only' if icon_only else '')"
              aria-haspopup="menu" :aria-expanded="'true' if _open else 'false'"
              :aria-controls="_id + '-list' if _open else None"
              :aria-label="label if icon_only else None" :disabled="disabled"
              @click="toggle" @keydown.down.prevent="open_at('first')" @keydown.up.prevent="open_at('last')">
        <If cond="icon"><Icon :name="icon" size="1.15em" /></If>
        <If cond="not icon_only"><span class="text"><Slot>{{ label }}</Slot></span></If>
        <If cond="caret and not icon_only"><Icon name="chevron-down" size="1em" /></If>
      </button>
    </Else>
    <If cond="_open">
      <div class="backdrop" @click="close(False)" @contextmenu.prevent="close(False)"></div>
      <MenuList class="drop" :items="items" :custom="has_slot('item')" :start="_start"
                :side="'left' if align == 'end' else 'right'"
                :list_id="_id + '-list'" :labelled_by="_id + '-button'"
                @select="choose(event)" @close="close(event)">
        <Fill name="item"><Slot name="item" :item="item" /></Fill>
      </MenuList>
    </If>
  </div>
</template>

<code>
# <ui.Menu label="Actions" :items="['Edit', 'Duplicate', '-', ('delete', 'Delete')]"
#          @select="act(event)" />
# A button that opens a list of actions, and emits "select" with the chosen
# item's value. items: text, (value, label) pairs, or dicts with value,
# label, and optionally icon, description, hint (e.g. a shortcut), danger
# (red), disabled and items (a submenu, opened beside it); "-" is a
# divider, {"heading": "..."} a group heading.
# <Fill name="trigger"> replaces the button's look with your own content
# (an avatar, say: content, not another button); <Fill name="item"> lays
# out each item (it gets `item`: label, value, icon, description, hint,
# data). position: below or above the button; align: start or end.
# Keyboard: Enter, Space or Down opens it on the first item, Up on the last;
# arrows, Home and End move; Right opens a submenu, Left goes back; Enter
# picks; Esc closes and returns to the button; Tab closes and moves on.
import itertools

label: str = "Menu"       # the button's text (and its name for screen readers)
items: list = []
icon: str = ""            # an icon on the button, such as "more" or "settings"
icon_only: bool = False   # just the icon; label still names it
variant: str = "secondary"  # the button's look: primary, secondary, ghost
align: str = "start"      # where the list lines up: start or end of the button
position: str = "below"   # below or above the button
caret: bool = True        # the small arrow after the text
disabled: bool = False

_ids = itertools.count(1)
_open = False
_start = "first"

def on_init(self):
    self._id = f"ui-menu-{next(_ids)}"

def toggle(self):
    if self._open:
        self.close(True)
    else:
        self.open_at("first")

def open_at(self, which):
    if self.disabled or not self.items:
        return
    self._open = True
    self._start = which

def close(self, refocus):
    if not self._open:
        return
    self._open = False
    if refocus:
        self.focus("trigger")

def choose(self, value):
    self.close(True)
    self.emit("select", value)
</code>

<style>
.menu { position: relative; display: inline-block; }
.trigger {
  display: inline-flex; align-items: center; gap: 0.45em;
  font: inherit; font-size: 0.95rem; font-weight: 550; line-height: 1.2;
  padding: 0.5em 0.85em; border-radius: var(--ui-radius, 8px);
  border: 1px solid transparent; cursor: pointer; white-space: nowrap;
  transition: background-color 0.15s, border-color 0.15s, box-shadow 0.15s;
}
.trigger.icon-only { padding: 0.5em; }
.trigger.bare { padding: 0; border: 0; background: transparent; color: inherit; border-radius: var(--ui-radius, 8px); }
.trigger:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--ui-primary, #4f46e5) 35%, transparent);
}
.trigger:disabled { opacity: 0.55; cursor: not-allowed; }
.btn-primary { background: var(--ui-primary, #4f46e5); color: var(--ui-on-primary, #fff); }
.btn-primary:hover:not(:disabled) { background: color-mix(in srgb, var(--ui-primary, #4f46e5) 88%, black); }
.btn-secondary {
  background: var(--ui-surface, #fff); color: var(--ui-text, #1f2328);
  border-color: var(--ui-border, #d1d9e0);
}
.btn-secondary:hover:not(:disabled), .btn-ghost:hover:not(:disabled) { background: var(--ui-subtle, #f6f8fa); }
.btn-ghost { background: transparent; color: var(--ui-text, #1f2328); }
.backdrop { position: fixed; inset: 0; z-index: 999; }
.drop { position: absolute; top: calc(100% + 4px); left: 0; z-index: 1000; min-width: max(100%, 11rem); }
.pos-above .drop { top: auto; bottom: calc(100% + 4px); }
.align-end .drop { left: auto; right: 0; }
</style>
