<template>
  <div class="host">
    <If cond="value">
      <div class="backdrop" @click.self="dismiss" @keydown.esc="dismiss">
        <div class="dialog" role="dialog" aria-modal="true" :aria-label="title or None"
             tabindex="-1" autofocus="" :style="f'max-width: {width}'">
          <header class="head">
            <h2 class="title">{{ title }}</h2>
            <If cond="dismissible">
              <button class="close" type="button" aria-label="Close" @click="close"><Icon name="x" size="1.2em" /></button>
            </If>
          </header>
          <div class="body"><Slot /></div>
          <If cond="has_slot('footer')"><footer class="foot"><Slot name="footer" /></footer></If>
        </div>
      </div>
    </If>
  </div>
</template>

<code>
# <ui.Dialog title="Delete file?" @bind="confirming"> ... </ui.Dialog>
# Open while the bound field is True. Esc, a click outside, or the X set it
# back to False (unless dismissible="false") and emit "close".
value: bool = False
title: str = ""
width: str = "32rem"
dismissible: bool = True

def close(self):
    self.emit("update", False)
    self.emit("close")

def dismiss(self):
    if self.dismissible:
        self.close()
</code>

<style>
.host { display: contents; }
.backdrop {
  position: fixed; inset: 0; z-index: 1000;
  display: grid; place-items: center; padding: 16px;
  background: rgba(15, 23, 42, 0.5);
  animation: ui-dialog-fade 0.12s ease-out;
}
.dialog {
  width: 100%; max-height: calc(100vh - 32px); overflow: auto;
  background: var(--ui-surface, #fff); color: var(--ui-text, #1f2328);
  border-radius: calc(var(--ui-radius, 8px) * 1.5);
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  outline: none;
  animation: ui-dialog-rise 0.15s ease-out;
}
.head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px 0; }
.title { margin: 0; font-size: 1.15rem; font-weight: 650; }
.close {
  border: 0; background: transparent; color: var(--ui-muted, #59636e);
  cursor: pointer; padding: 4px; border-radius: 6px; line-height: 0;
}
.close:hover { background: var(--ui-subtle, #f6f8fa); color: var(--ui-text, #1f2328); }
.body { padding: 12px 20px 20px; }
.foot {
  display: flex; justify-content: flex-end; gap: 8px; flex-wrap: wrap;
  padding: 12px 20px; border-top: 1px solid var(--ui-border, #d1d9e0);
}
@keyframes ui-dialog-fade { from { opacity: 0; } }
@keyframes ui-dialog-rise { from { opacity: 0; transform: translateY(8px) scale(0.98); } }
@media (prefers-reduced-motion: reduce) { .backdrop, .dialog { animation: none; } }
</style>
