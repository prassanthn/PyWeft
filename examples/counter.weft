<template>
  <div class="counter">
    <h1>Count: {{ count }}</h1>

    <input @bind="name" placeholder="your name" />
    <button @click="increment">+1</button>
    <button @click="reset">reset</button>

    <If cond="count == 0">
      <p class="hint">click the button</p>
    </If>
    <ElseIf cond="count > 3">
      <p class="loud">that's a lot of clicks{{ greeting }}</p>
    </ElseIf>
    <Else>
      <p class="hint">keep going</p>
    </Else>

    <ul>
      <For each="entry in history" key="entry['id']" index="i">
        <li @click="forget(entry)">{{ i }}. {{ entry['label'] }}</li>
      </For>
    </ul>
  </div>
</template>

<code>
count: int = 0
name: str = ""
history: list = []

@property
def greeting(self):
    return f", {self.name}" if self.name else ""

def increment(self):
    self.count += 1
    self.history.append({"id": self.count, "label": f"click {self.count}"})

def reset(self):
    self.count = 0
    self.history = []

def forget(self, entry):
    self.history = [h for h in self.history if h["id"] != entry["id"]]
</code>
