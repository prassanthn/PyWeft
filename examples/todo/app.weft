<template>
  <div class="todo-app">
    <h1>Todos <small>{{ remaining_label }} left</small></h1>

    <input @bind="draft" placeholder="what needs doing?" />
    <button @click="add">add</button>

    <ul>
      <For each="item in items" key="item['id']">
        <TodoItem :item="item" @toggle="toggle(event)" @remove="remove(event)" />
      </For>
    </ul>

    <If cond="not items">
      <p class="hint">nothing yet — add one above</p>
    </If>
  </div>
</template>

<style>
/* Scoped to this component. The bare `input, button` rule cannot reach the
   remove button inside TodoItem: that one belongs to the child. */
.todo-app { border: 1px solid #ddd; border-radius: 8px; padding: 1.5rem; }
h1 small { color: #aaa; font-size: 0.9rem; font-weight: normal; }
input, button { font: inherit; padding: 0.35rem 0.7rem; margin-right: 0.4rem; }
ul { padding-left: 0; list-style: none; }
.hint { color: #888; }
</style>

<code>
import humanize  # from PyPI, declared in this app's pyproject.toml
from pyweft import effect

draft: str = ""
items: list = []
next_id: int = 1

@property
def remaining_label(self):
    # apnumber spells out small numbers: 3 -> "three"
    return humanize.apnumber(sum(1 for item in self.items if not item["done"]))

@effect
def sync_tab_title(self):
    # Re-runs only when `items` changes (read through remaining_label), so
    # typing in the input does not touch the title.
    import js
    js.document.title = f"{self.remaining_label} left · todos"

def add(self):
    text = self.draft.strip()
    if not text:
        return
    self.items.append({"id": self.next_id, "text": text, "done": False})
    self.next_id += 1
    self.draft = ""

def toggle(self, item):
    item["done"] = not item["done"]

def remove(self, item):
    self.items = [i for i in self.items if i["id"] != item["id"]]
</code>
