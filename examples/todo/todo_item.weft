<template>
  <li class="todo-item">
    <span :class="'done' if item['done'] else None" @click="emit('toggle', item)">
      {{ item['text'] }}
    </span>
    <button class="remove" @click="emit('remove', item)">✕</button>
  </li>
</template>

<style>
/* Scoped: only elements rendered by this component match. */
.todo-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.2rem 0; }
span { cursor: pointer; }
.done { text-decoration: line-through; color: #aaa; }
.remove { border: none; background: none; color: var(--danger); cursor: pointer; }
</style>

<code>
item: dict = {}
</code>
