<template>
  <section>
    <h1>Orders</h1>
    <p class="filters">
      Show:
      <For each="choice in ['all', 'paid', 'pending', 'refunded']" key="choice">
        <Link :to="'/orders' if choice == 'all' else '/orders?status=' + choice"
              :class="'on' if choice == status else None">{{ choice }}</Link>
      </For>
    </p>
    <ul>
      <For each="order in shown" key="order['id']">
        <li><Link :to="'/orders/' + str(order['id'])">#{{ order['id'] }}</Link>
          {{ order['customer'] }} ({{ order['status'] }})
          <If cond="order['id'] in pins.ids"><b>pinned</b></If></li>
      </For>
    </ul>
    <p class="tools">
      <button @click="export">Export CSV</button>
      <If cond="pins.count"><button @click="clear_pins">Clear pins</button></If>
    </p>
  </section>
</template>

<code>
# Shown at #/orders; ?status=paid fills the `status` field.
import csv
import io
from pyweft import Link, dialogs, set_title
from orders_data import ORDERS
from pins import pins

status: str = "all"

def on_init(self):
    set_title("Orders - Shop")

@property
def shown(self):
    if self.status == "all":
        return ORDERS
    return [o for o in ORDERS if o["status"] == self.status]

async def export(self):
    # A Save As dialog in the desktop app, a download in the browser.
    out = io.StringIO()
    writer = csv.DictWriter(out, fieldnames=list(ORDERS[0]))
    writer.writeheader()
    writer.writerows(self.shown)
    await dialogs.save_file(out.getvalue(), name=f"orders-{self.status}.csv")

async def clear_pins(self):
    count = f"{pins.count} order" + ("s" if pins.count != 1 else "")
    if await dialogs.confirm(f"Unpin {count}?", title="Clear pins"):
        pins.ids = []
</code>

<style>
.filters { display: flex; gap: 0.75rem; align-items: center; }
.on { font-weight: 700; text-decoration: none; color: #111; }
.tools { display: flex; gap: 0.5rem; }
</style>
