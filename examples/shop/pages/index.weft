<template>
  <div class="space-y-8">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">Dashboard</h1>
      <p class="mt-1 text-slate-500 dark:text-slate-400">How the shop is doing this week.</p>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      <For each="stat in stats" key="stat['label']">
        <Link :to="stat['to']"
              class="group rounded-2xl bg-white p-4 shadow-sm sm:p-5 ring-1 ring-slate-900/5 transition hover:-translate-y-0.5 hover:shadow-md dark:bg-slate-900 dark:ring-white/10">
          <p class="text-sm font-medium text-slate-500 dark:text-slate-400">{{ stat['label'] }}</p>
          <p class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl text-slate-900 tabular-nums dark:text-white">{{ stat['value'] }}</p>
          <p class="mt-1 text-xs text-slate-400 sm:text-sm group-hover:text-indigo-600 dark:text-slate-500 dark:group-hover:text-indigo-400">{{ stat['note'] }} →</p>
        </Link>
      </For>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <section class="rounded-2xl bg-white shadow-sm ring-1 ring-slate-900/5 lg:col-span-2 dark:bg-slate-900 dark:ring-white/10">
        <div class="flex items-center justify-between px-6 pt-5 pb-3">
          <h2 class="font-semibold text-slate-900 dark:text-white">Recent orders</h2>
          <Link to="/orders" class="text-sm font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400">View all</Link>
        </div>
        <ul class="divide-y divide-slate-100 dark:divide-white/5">
          <For each="order in recent" key="order['id']">
            <li>
              <Link :to="'/orders/' + str(order['id'])"
                    class="flex items-center gap-4 px-6 py-3.5 transition hover:bg-slate-50 dark:hover:bg-white/5">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-sm font-semibold text-indigo-700 dark:bg-indigo-400/10 dark:text-indigo-300">
                  {{ initials(order['customer']) }}
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-medium text-slate-900 dark:text-white">{{ order['customer'] }}</span>
                  <span class="block text-sm text-slate-500 dark:text-slate-400">#{{ order['id'] }} · {{ nice_date(order['date']) }}</span>
                </span>
                <span class="hidden sm:block"><components.StatusBadge :status="order['status']" /></span>
                <span class="text-right sm:w-24 font-medium text-slate-900 tabular-nums dark:text-white">{{ money(order['total']) }}</span>
              </Link>
            </li>
          </For>
        </ul>
      </section>

      <aside class="self-start rounded-2xl bg-linear-to-br from-indigo-600 to-violet-600 p-6 text-white shadow-sm">
        <h2 class="font-semibold">A page per file</h2>
        <p class="mt-2 text-sm/6 text-indigo-100">
          Every screen of this app is a <code class="rounded bg-white/15 px-1 py-0.5">.weft</code> file in
          <code class="rounded bg-white/15 px-1 py-0.5">pages/</code>. Try the links, the browser's
          Back button, or an address that doesn't exist.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <button type="button" @click="navigate('/orders', query={'status': 'pending'})"
                  class="rounded-lg bg-white px-3 py-2 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-50">
            Pending orders
          </button>
          <a href="#/nowhere" class="rounded-lg px-3 py-2 text-sm font-semibold text-white ring-1 ring-white/30 transition hover:bg-white/10">
            #/nowhere
          </a>
        </div>
      </aside>
    </div>
  </div>
</template>

<code>
from pyweft import Link, navigate, set_title
from orders_data import ORDERS, initials, money, nice_date
from pins import pins

def on_init(self):
    set_title("Shop")   # each page names itself; a title stays until the next

@property
def recent(self):
    return ORDERS[:5]

@property
def stats(self):
    paid = [o for o in ORDERS if o["status"] == "paid"]
    pending = sum(1 for o in ORDERS if o["status"] == "pending")
    return [
        {"label": "Revenue", "value": money(sum(o["total"] for o in paid)),
         "note": f"from {len(paid)} paid orders", "to": "/orders?status=paid"},
        {"label": "Orders", "value": len(ORDERS), "note": "all orders", "to": "/orders"},
        {"label": "Pending", "value": pending, "note": "waiting for payment",
         "to": "/orders?status=pending"},
        {"label": "Pinned", "value": pins.count, "note": "orders you pinned", "to": "/orders"},
    ]
</code>
