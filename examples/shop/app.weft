<template>
  <div class="shell">
    <header>
      <strong>Shop</strong>
      <nav>
        <Link to="/">Home</Link>
        <Link to="/orders">Orders</Link>
        <Link to="/help">Help</Link>
      </nav>
      <span class="pins">Pinned: {{ pins.count }}</span>
    </header>
    <main><Pages /></main>
  </div>
</template>

<code>
# Each .weft file in pages/ is a screen: pages/orders.weft is #/orders.
# orders_data.py holds the data the pages share; pins.py is a Store, state
# that any page changes and the header shows.
from pyweft import Link, router
from pins import pins

Pages = router("pages")
</code>

