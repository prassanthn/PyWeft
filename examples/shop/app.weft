<code>
# Each .weft file in pages/ is a screen: pages/orders.weft is #/orders.
# orders_data.py holds the data the pages share; pins.py is a Store, state
# that any page changes and the header shows. Styled with Tailwind: head.html
# links tailwind.css, built from these files' classes (_tailwind/input.css).
from pyweft import Link, router
from pins import pins

Pages = router("pages")

nav_links: list = [
    {"to": "/", "label": "Dashboard"},
    {"to": "/orders", "label": "Orders"},
    {"to": "/help", "label": "Help"},
]
</code>
