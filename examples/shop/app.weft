header { display: flex; align-items: center; gap: 2rem; padding: 0.75rem 0; border-bottom: 1px solid #ddd; }
nav { display: flex; gap: 1rem; }
nav a { color: #555; text-decoration: none; padding: 0.25rem 0; border-bottom: 2px solid transparent; }
